# Doxyfile 1.9.8

# Project related configuration options
PROJECT_NAME           = "SomaticVR-Tracker-Emulator"
PROJECT_BRIEF          = "C# project for VR tracker emulation"
OUTPUT_DIRECTORY       = docs
CREATE_SUBDIRS         = NO
OUTPUT_LANGUAGE        = English
INPUT                  = ../src
FILE_PATTERNS          = *.cs
RECURSIVE              = YES
EXCLUDE                = 
EXCLUDE_PATTERNS       = 
EXCLUDE_SYMLINKS       = NO

# Build related configuration options
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
EXTRACT_ANON_NSPACES   = YES

# If you want to include .NET XML documentation comments
JAVADOC_AUTOBRIEF      = YES
MULTILINE_CPP_IS_BRIEF = YES

# Source browsing
SOURCE_BROWSER         = YES
INLINE_SOURCES         = YES
STRIP_CODE_COMMENTS    = NO

# HTML output
GENERATE_HTML          = YES
HTML_OUTPUT            = html

# LaTeX output
GENERATE_LATEX         = NO

# Dot (graphviz) support
HAVE_DOT               = YES
CALL_GRAPH             = YES
CALLER_GRAPH           = YES
DOT_IMAGE_FORMAT       = svg

# Other
QUIET                  = NO
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
INPUT_ENCODING         = UTF-8